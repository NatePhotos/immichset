# Copy to .deploy.env and fill in. That file is gitignored: it names your server.

# Where server.mjs and web/ live on the host, as this machine can reach them.
# A mounted share, for example, or a local path if you deploy on the host itself.
DEST="/Volumes/your-share/galleryapp"

# The app's base URL. The LAN or VPN address is fine and avoids a round trip
# through the public internet.
BASE="http://your-host:3100"

# ADMIN_TOKEN from the container's compose. Used to restart and to run the tests.
ADMIN_TOKEN=""
